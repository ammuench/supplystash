# Root env template — copy to `.env` and fill in.
# This file is for repo-level tooling (Supabase CLI), not the app bundle.
# App-facing vars live in apps/supplystash/.env.example.

# Direct Postgres connection string for the hosted (prod) Supabase project.
# Used by `pnpm db:migrate:prod` and the deploy-db-prod GitHub workflow, where
# it comes from the SUPABASE_DB_URL_PROD repository secret instead of this file.
SUPABASE_DB_URL_PROD=
