# CI-only secrets. Do NOT copy this file to a local `.env` — nothing loads it,
# and that is deliberate.
#
# Prod migrations run ONLY through the deploy-db-prod GitHub workflow.
# Running them from a laptop is not supported by design.
#
# App-facing vars live in apps/supplystash/.env.example. See README.md for
# the full map of which env var lives where.

# GitHub repo secret: SUPABASE_DB_URL_PROD
# Direct Postgres connection string for the hosted (prod) Supabase project.
# Consumed by `pnpm db:migrate:prod` inside the workflow, where it comes from
# the repository secret. Locally this expands to an empty string, which is the
# safeguard working — not a bug to fix.
SUPABASE_DB_URL_PROD=
