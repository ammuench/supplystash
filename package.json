{
  "name": "supplystash",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @supplystash/app dev",
    "dev:web": "pnpm --filter @supplystash/app web",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check-types": "pnpm --filter @supplystash/app check-types",
    "prepare": "lefthook install",
    "build:app:dev": "pnpm --filter @supplystash/app build:dev",
    "build:app:preview": "pnpm --filter @supplystash/app build:preview",
    "build:app:prod": "pnpm --filter @supplystash/app build:prod",
    "build:app:ios-sim": "pnpm --filter @supplystash/app build:ios-sim",
    "submit:app:ios": "pnpm --filter @supplystash/app submit:prod:ios",
    "submit:app:android": "pnpm --filter @supplystash/app submit:prod:android",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:migrate:prod": "supabase db push --db-url \"$SUPABASE_DB_URL_PROD\" --yes",
    "db:migrate:prod:dry": "supabase db push --db-url \"$SUPABASE_DB_URL_PROD\" --dry-run",
    "db:new-migration": "supabase migration new",
    "db:test": "supabase test db",
    "db:lint": "squawk supabase/migrations/*.sql"
  },
  "devDependencies": {
    "lefthook": "^2.1.5",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "squawk-cli": "^2.47.0",
    "supabase": "^2.91.1",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@10.33.0"
}
