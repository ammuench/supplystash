{
  "name": "@supplystash/app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start --dev-client -c",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:dev": "EAS_BUILD_PROFILE=development eas build --profile development",
    "build:preview": "EAS_BUILD_PROFILE=preview eas build --profile preview",
    "build:prod": "EAS_BUILD_PROFILE=production eas build --profile production",
    "build:ios-sim": "EAS_BUILD_PROFILE=development-simulator eas build --profile development-simulator --platform ios --local",
    "submit:prod:ios": "EAS_BUILD_PROFILE=production eas submit --profile production --platform ios --latest",
    "submit:prod:android": "EAS_BUILD_PROFILE=production eas submit --profile production --platform android --latest",
    "credentials:prod": "EAS_BUILD_PROFILE=production eas credentials",
    "prebuild": "expo prebuild",
    "web": "expo start --web",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@rn-primitives/alert-dialog": "^1.5.2",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "~1.4.0",
    "@rn-primitives/progress": "^1.5.2",
    "@rn-primitives/radio-group": "^1.5.2",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~56.0.13",
    "expo-constants": "~56.0.19",
    "expo-dev-client": "~56.0.24",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.12",
    "expo-splash-screen": "~56.0.11",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.26",
    "lucide-react-native": "^1.21.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-keyboard-controller": "^1.22.4",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "uniwind": "^1.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6.0.3"
  }
}
