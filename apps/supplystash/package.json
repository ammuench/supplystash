{
  "name": "@supplystash/app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start --dev-client -c",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:dev": "EAS_BUILD_PROFILE=development eas build --profile development",
    "build:preview": "EAS_BUILD_PROFILE=preview eas build --profile preview",
    "build:prod": "EAS_BUILD_PROFILE=production eas build --profile production",
    "build:ios-sim": "EAS_BUILD_PROFILE=development-simulator eas build --profile development-simulator --platform ios --local",
    "submit:prod:ios": "EAS_BUILD_PROFILE=production eas submit --profile production --platform ios --latest",
    "submit:prod:android": "EAS_BUILD_PROFILE=production eas submit --profile production --platform android --latest",
    "credentials:prod": "EAS_BUILD_PROFILE=production eas credentials",
    "prebuild": "expo prebuild",
    "web": "expo start -c --web",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "eas-build-post-install": "if [ \"$EAS_BUILD_PROFILE\" = \"preview\" ] || [ \"$EAS_BUILD_PROFILE\" = \"production\" ]; then npm i -g @posthog/cli@$(node -p \"require('@posthog/cli/package.json').version\"); fi"
  },
  "dependencies": {
    "@backpackapp-io/react-native-toast": "^0.15.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/alert-dialog": "^1.5.2",
    "@rn-primitives/avatar": "^1.5.2",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/dropdown-menu": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "~1.4.0",
    "@rn-primitives/progress": "^1.5.2",
    "@rn-primitives/radio-group": "^1.5.2",
    "@rn-primitives/select": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "@rn-primitives/switch": "^1.5.2",
    "@rn-primitives/tabs": "^1.5.2",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "aes-js": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~56.0.13",
    "expo-application": "~56.0.3",
    "expo-constants": "~56.0.19",
    "expo-crypto": "~56.0.5",
    "expo-dev-client": "~56.0.24",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-haptics": "~56.0.3",
    "expo-linking": "~56.0.14",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.12",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.11",
    "expo-sqlite": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-updates": "~56.0.26",
    "expo-web-browser": "~56.0.6",
    "lucide-react-native": "^1.21.0",
    "luxon": "^3.7.2",
    "nativewind": "^4.2.6",
    "posthog-react-native": "^4.66.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "^1.22.4",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "uniwind": "^1.10.1",
    "zod": "^4.5.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@faker-js/faker": "^10.6.0",
    "@posthog/cli": "^0.16.0",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/aes-js": "^3.1.4",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.5",
    "@types/node": "~24.3.0",
    "@types/react": "~19.2.10",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "react-native-gesture-handler/jestSetup.js",
      "./utils/testing/setupTests.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!\\.pnpm)(?!((jest-)?react-native.*|@react-native(-community)?/.*|expo|expo-.*|exponent|@expo/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|native-base|uniwind|@rn-primitives/.*|@gorhom/.*|@backpackapp-io/.*|@faker-js/faker|standard-navigation|react-native-keyboard-controller)/)"
    ]
  }
}
