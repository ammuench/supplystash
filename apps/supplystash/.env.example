# Mobile env template — copy to `.env` and fill in.
# Only `EXPO_PUBLIC_*` vars are exposed to the client bundle.
# EAS builds get these from `eas.json` at build time; this file is only for the
# local Metro dev server.

# Local Supabase stack. Run `pnpm db:start`, then `pnpm db:status` to read the
# API URL and anon key off the running containers.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
